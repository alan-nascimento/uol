<%- include('partials/head', { title: site.site_name }) %>

<section class="page-header">
    <h1>Attendee Home Page</h1>
    <p class="lead"><strong><%= site.site_name %></strong> — <%= site.site_description %></p>
</section>

<section>
    <h2>Upcoming events</h2>
    <% if (events.length === 0) { %>
        <p class="muted">There are no events available at the moment. Please check back soon.</p>
    <% } else { %>
        <ul class="event-list">
            <% events.forEach(function (event) { %>
                <li class="card event-card">
                    <a class="event-link" href="/attendee/event/<%= event.event_id %>">
                        <h3><%= event.title %></h3>
                        <p class="muted"><%= formatEventDate(event.event_date) %></p>
                    </a>
                </li>
            <% }); %>
        </ul>
    <% } %>
</section>

<%- include('partials/footer') %>
